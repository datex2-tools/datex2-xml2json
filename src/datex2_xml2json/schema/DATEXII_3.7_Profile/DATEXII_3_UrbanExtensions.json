{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AccidentExtendedUrban": {
      "title": "AccidentExtendedUrban",
      "description": "Extension to accident class.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupOfNonVehicularRoadUsersInvolved": {
          "title": "groupOfNonVehicularRoadUsersInvolved",
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_UrbanExtensions.json#/$defs/GroupOfNonVehicularRoadUsersInvolved"
          },
          "minItems": 0
        }
      }
    },
    "ClassifiedDelay": {
      "title": "ClassifiedDelay",
      "description": "A delay valid for vehicles with specific characteristics.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delays": {
          "title": "delays",
          "$ref": "DATEXII_3_Situation.json#/$defs/Delays"
        },
        "vehicleCharacteristics": {
          "title": "vehicleCharacteristics",
          "$ref": "DATEXII_3_Common.json#/$defs/VehicleCharacteristics"
        },
        "ubxClassifiedDelayExtensionG": {
          "title": "ubxClassifiedDelayExtensionG",
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      },
      "required": [
        "vehicleCharacteristics",
        "delays"
      ]
    },
    "GroupOfNonVehicularRoadUsersInvolved": {
      "title": "GroupOfNonVehicularRoadUsersInvolved",
      "description": "Group of involved road users who are not users of vehicles (e.g. pedestrians).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numberOfNonVehicularRoadUsers": {
          "title": "numberOfNonVehicularRoadUsers",
          "description": "The number of non-vehicular road users.",
          "$ref": "DATEXII_3_Common.json#/$defs/NonNegativeInteger"
        },
        "injuryStatusType": {
          "title": "injuryStatusType",
          "description": "The injury status of road users who are not users of vehicles involved.",
          "$ref": "DATEXII_3_Situation.json#/$defs/InjuryStatusTypeEnumG"
        },
        "nonVehicularRoadUsers": {
          "title": "nonVehicularRoadUsers",
          "$ref": "DATEXII_3_UrbanExtensions.json#/$defs/NonVehicularRoadUsers"
        },
        "ubxGroupOfNonVehicularRoadUsersInvolvedExtensionG": {
          "title": "ubxGroupOfNonVehicularRoadUsersInvolvedExtensionG",
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      }
    },
    "ImpactExtendedUrban": {
      "title": "ImpactExtendedUrban",
      "description": "Extension for impact class.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classifiedDelay": {
          "title": "classifiedDelay",
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_UrbanExtensions.json#/$defs/ClassifiedDelay"
          },
          "minItems": 0
        }
      }
    },
    "NetworkManagementExtendedUrban": {
      "title": "NetworkManagementExtendedUrban",
      "description": "Extension for network management.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forNonMotorisedRoadUsers": {
          "title": "forNonMotorisedRoadUsers",
          "$ref": "DATEXII_3_UrbanExtensions.json#/$defs/NonVehicularRoadUsers"
        }
      }
    },
    "NonVehicularRoadUsers": {
      "title": "NonVehicularRoadUsers",
      "description": "Road users who are not users of vehicles (e.g. pedestrians)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nonVehicularRoadUser": {
          "title": "nonVehicularRoadUser",
          "description": "A road user that does not use a vehicle.",
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_UrbanExtensions.json#/$defs/NonVehicularRoadUserTypeEnumG"
          },
          "minItems": 1
        },
        "ubxNonVehicularRoadUsersExtensionG": {
          "title": "ubxNonVehicularRoadUsersExtensionG",
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      },
      "required": [
        "nonVehicularRoadUser"
      ]
    },
    "NonVehicularRoadUserTypeEnum": {
      "title": "NonVehicularRoadUserTypeEnum",
      "description": "Road users that do not use a vehicle.",
      "type": "string",
      "enum": [
        "pedestrian",
        "skater",
        "animalUnderGuidance",
        "other",
        "extendedG"
      ]
    },
    "NonVehicularRoadUserTypeEnumG": {
      "title": "NonVehicularRoadUserTypeEnumG",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_UrbanExtensions.json#/$defs/NonVehicularRoadUserTypeEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "StreetWorks": {
      "title": "StreetWorks",
      "description": "Non-highway related infrastructure or maintenance works on or close to the road.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streetWorksType": {
          "title": "streetWorksType",
          "description": "The type of the non-highway related infrastructure or maintenance works on or close to the road.",
          "$ref": "DATEXII_3_UrbanExtensions.json#/$defs/StreetWorksTypeEnumG"
        }
      },
      "required": [
        "streetWorksType"
      ]
    },
    "StreetWorksTypeEnum": {
      "title": "StreetWorksTypeEnum",
      "description": "Types of non-highway related infrastructure or maintenance works on or close to the road.",
      "type": "string",
      "enum": [
        "buildingWork",
        "trenchingWork",
        "utilityWork",
        "extendedG"
      ]
    },
    "StreetWorksTypeEnumG": {
      "title": "StreetWorksTypeEnumG",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_UrbanExtensions.json#/$defs/StreetWorksTypeEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    }
  }
}