      <xs:enumeration value="operatingMode2">
        <xs:annotation>
          <xs:documentation>"Publisher Push Periodic" operating mode.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="operatingMode3">
