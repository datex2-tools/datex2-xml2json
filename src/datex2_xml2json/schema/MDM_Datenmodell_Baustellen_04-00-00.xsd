    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="operatingMode0">
        <xs:annotation>
          <xs:documentation>"Subscription Management Mechanism" - a specialized operating mode to handle subscriptions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="operatingMode1">
        <xs:annotation>
          <xs:documentation>"Publisher Push on Occurrence" operating mode.</xs:documentation>
        </xs:annotation>
